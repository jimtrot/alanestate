---
/**
 * Progressive-enhancement waitlist form.
 * No JS: posts to FormSubmit and lands on /thanks/.
 * With JS: posts via fetch and shows an inline confirmation.
 */
import { SITE, STATES } from '../data/site';

interface Props {
  variant: 'families' | 'professionals' | 'plan';
  id?: string;
  heading?: string;
  intro?: string;
  compact?: boolean;
  /** Extra hidden context, e.g. plan summary or page name */
  context?: Record<string, string>;
}
const { variant, id = 'waitlist', heading, intro, compact = false, context = {} } = Astro.props;
const subject = variant === 'professionals' ? 'Alan Estate — professional waitlist' : variant === 'plan' ? 'Alan Estate — plan request' : 'Alan Estate — family waitlist';
---
<div id={id} class="scroll-mt-24">
  {heading && <h2 class="mb-2">{heading}</h2>}
  {intro && <p class="text-ink-2 mb-6 max-w-prose">{intro}</p>}
  <form class="waitlist-form card grid gap-5" method="POST" action={SITE.formEndpoint} data-ajax={SITE.formAjax} novalidate>
    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_next" value={`${SITE.url}/thanks/`} />
    <input type="hidden" name="segment" value={variant} />
    <input type="hidden" name="page" value={Astro.url.pathname} />
    <input type="hidden" name="referrer" value="" data-fill="referrer" />
    <input type="hidden" name="utm" value="" data-fill="utm" />
    {Object.entries(context).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    {variant === 'families' && (
      <>
        <fieldset class="grid gap-2">
          <legend class="label mb-1">Which of these is closest to your situation?</legend>
          <label class="choice"><input type="radio" name="situation" value="someone-has-died" required /><span>Someone close to me has died and I'm working out what to do</span></label>
          <label class="choice"><input type="radio" name="situation" value="my-own-affairs" /><span>I want to get my own affairs in order so my family isn't left guessing</span></label>
          <label class="choice"><input type="radio" name="situation" value="helping-a-parent" /><span>I'm helping a parent or partner get organised</span></label>
        </fieldset>
        <div class={`grid gap-5 ${compact ? '' : 'sm:grid-cols-2'}`}>
          <div class="field">
            <label class="label" for={`${id}-name`}>First name <span class="text-ink-3 font-normal">(optional)</span></label>
            <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="given-name" />
          </div>
          <div class="field">
            <label class="label" for={`${id}-state`}>State or territory</label>
            <select class="select" id={`${id}-state`} name="state" required>
              <option value="">Choose…</option>
              {STATES.map((s) => <option value={s.code}>{s.name}</option>)}
            </select>
          </div>
        </div>
        <label class="choice"><input type="checkbox" name="smsf" value="yes" /><span>There is a self-managed super fund (SMSF) involved</span></label>
      </>
    )}

    {variant === 'professionals' && (
      <>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field">
            <label class="label" for={`${id}-name`}>Your name</label>
            <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label class="label" for={`${id}-org`}>Organisation</label>
            <input class="input" id={`${id}-org`} name="organisation" type="text" autocomplete="organization" required />
          </div>
          <div class="field">
            <label class="label" for={`${id}-type`}>What kind of organisation?</label>
            <select class="select" id={`${id}-type`} name="organisation_type" required>
              <option value="">Choose…</option>
              <option>Funeral home</option>
              <option>Aged care provider</option>
              <option>SMSF accountant or administrator</option>
              <option>Financial adviser</option>
              <option>Estate or succession lawyer</option>
              <option>Public trustee or trustee company</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label class="label" for={`${id}-state`}>State or territory</label>
            <select class="select" id={`${id}-state`} name="state" required>
              <option value="">Choose…</option>
              {STATES.map((s) => <option value={s.code}>{s.name}</option>)}
              <option value="National">National</option>
            </select>
          </div>
          <div class="field sm:col-span-2">
            <label class="label" for={`${id}-volume`}>Roughly how many families or SMSF clients do you work with a year?</label>
            <select class="select" id={`${id}-volume`} name="volume">
              <option value="">Prefer not to say</option>
              <option>Under 50</option>
              <option>50 to 200</option>
              <option>200 to 500</option>
              <option>More than 500</option>
            </select>
          </div>
        </div>
        <label class="choice"><input type="checkbox" name="founding_partner" value="yes" /><span>I'm open to a conversation about the founding partner pilot</span></label>
      </>
    )}

    <div class="field">
      <label class="label" for={`${id}-email`}>{variant === 'professionals' ? 'Work email' : 'Email'}</label>
      <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby={`${id}-email-help`} />
      <p class="help" id={`${id}-email-help`}>We'll use this to tell you when Alan Estate is ready{variant === 'plan' ? ' and to send your plan' : ''}. Nothing else.</p>
      <p class="error-text" data-error hidden>Please enter a valid email address so we can reach you.</p>
    </div>

    {variant !== 'plan' && (
      <div class="field">
        <label class="label" for={`${id}-note`}>{variant === 'professionals' ? "What's the biggest gap you see for the families or clients you work with?" : 'What would have helped most?'} <span class="text-ink-3 font-normal">(optional)</span></label>
        <textarea class="textarea" id={`${id}-note`} name="note" rows="3"></textarea>
      </div>
    )}

    <div class="flex flex-col sm:flex-row sm:items-center gap-4">
      <button type="submit" class="btn btn-primary" data-submit>
        <span data-label>{variant === 'plan' ? 'Email me my plan' : 'Join the waitlist'}</span>
      </button>
      <p class="text-sm text-ink-3">By joining you agree we can email you about Alan Estate. Unsubscribe any time. <a href="/privacy/" class="underline">Privacy</a>.</p>
    </div>
    <div class="note note-green" data-success hidden role="status" aria-live="polite">
      <p class="font-semibold">Thank you — you're on the list.</p>
      <p class="text-ink-2 mt-1">{variant === 'professionals' ? "We'll be in touch personally. If you'd rather talk sooner, reply to the confirmation email." : "We'll write when there's something worth your time. In the meantime, the guide is yours to use."}</p>
    </div>
    <div class="note" style="border-left-color: var(--color-error)" data-failure hidden role="alert">
      <p class="font-semibold">That didn't go through.</p>
      <p class="text-ink-2 mt-1">Please try again in a moment, or use the <a class="underline" href="/contact/">contact page</a>.</p>
    </div>
  </form>
</div>
<script>
  import { enhanceForms } from '../scripts/forms';
  enhanceForms();
</script>
