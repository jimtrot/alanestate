---
interface Props { class?: string; withWord?: boolean }
const { class: cls = '', withWord = true } = Astro.props;
---
<a href="/" class={`inline-flex items-center gap-2.5 no-underline ${cls}`} aria-label="Alan Estate — home">
  <svg width="30" height="30" viewBox="0 0 32 32" fill="none" aria-hidden="true" class="shrink-0">
    <rect x="1.5" y="1.5" width="29" height="29" rx="7" stroke="currentColor" stroke-width="1.5"/>
    <path d="M7.5 23.5C11.5 23.5 12.5 12 17.5 12c3.4 0 3.8 4.8 6.2 4.8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
    <circle cx="24.5" cy="9.5" r="2.4" fill="#b8642a"/>
  </svg>
  {withWord && <span class="serif text-[1.35rem] leading-none tracking-[-0.01em] text-ink">Alan Estate</span>}
</a>
