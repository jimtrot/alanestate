---
import Base from '../layouts/Base.astro';
import FormGuards from '../components/FormGuards.astro';
---
<Base title="Contact" description="Get in touch with the people building Alan Estate.">
  <section class="container-x py-16 md:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Contact</p>
      <h1>Get in touch</h1>
      <p class="lede mt-5">Questions, feedback or a correction to one of the guides. We read every message and reply by email.</p>
      <form class="ae-form card grid gap-5 mt-8" method="POST" novalidate>
        <input type="hidden" name="_subject" value="Alan Estate: contact" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="segment" value="contact" />
        <input type="hidden" name="page" value="/contact/" />
        <FormGuards id="c" />
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field"><label class="label" for="c-name">Name</label><input class="input" id="c-name" name="name" type="text" autocomplete="name" /></div>
          <div class="field">
            <label class="label" for="c-email">Email</label>
            <input class="input" id="c-email" name="email" type="email" autocomplete="email" required />
            <p class="error-text" data-error hidden>Please enter a valid email address so we can reply.</p>
          </div>
        </div>
        <div class="field"><label class="label" for="c-msg">Message</label><textarea class="textarea" id="c-msg" name="message" rows="5" required></textarea></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <button type="submit" class="btn btn-primary" data-submit><span data-label>Send</span></button>
          <p class="text-sm text-ink-3" data-consent>We use your email only to reply. <a href="/privacy/" class="underline">Privacy</a>.</p>
        </div>
        <div class="note note-green" data-success hidden role="status" aria-live="polite" tabindex="-1"><p class="font-semibold">Thanks, we've got your message.</p><p class="text-ink-2 mt-1">We'll reply by email.</p></div>
        <div class="note" style="border-left-color: var(--color-error)" data-failure hidden role="alert"><p class="font-semibold">That didn't go through.</p><p class="text-ink-2 mt-1">Please try again in a moment.</p></div>
      </form>
    </div>
  </section>
</Base>
<script>
  import { enhanceForms } from '../scripts/forms';
  enhanceForms();
</script>
