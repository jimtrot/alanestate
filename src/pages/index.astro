---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import GuideList from '../components/GuideList.astro';
import UpdatesForm from '../components/UpdatesForm.astro';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Alan Estate',
  url: SITE.url,
  description: SITE.description,
  areaServed: 'AU',
};
---
<Base title="Alan Estate" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="container-x pt-16 pb-14 md:pt-24 md:pb-20">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">When someone dies in Australia</p>
        <h1>There are around forty things to do after a death. This is the order they happen in.</h1>
        <p class="lede mt-6">Answer six questions and get a step-by-step plan for your state and situation, covering the will, superannuation, property and any self-managed super fund. Every step links to its official source.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/guide/" class="btn btn-primary">Build your plan</a>
          <a href="/guides/" class="btn btn-secondary">Read the guides</a>
        </div>
        <p class="mt-5 text-sm text-ink-3">Free. No account. Your answers stay in your browser.</p>
      </div>
      <div class="card-paper relative overflow-hidden">
        <p class="eyebrow mb-4">How the plan is sequenced</p>
        <ol class="space-y-4">
          {[
            ['Now', 'Register the death, find the will, get certified copies'],
            ['First two weeks', 'Notify Centrelink, banks, super and the ATO'],
            ['First month', 'Work out whether you need probate in your state'],
            ['If there is an SMSF', 'ATO within 28 days, trustee structure within six months'],
            ['Months two to six', 'Find every asset, settle debts, hold before distributing'],
          ].map(([when, what], i) => (
            <li class="flex gap-4 items-start">
              <span class="num text-2xl leading-none w-8 shrink-0 pt-0.5">{i + 1}</span>
              <div><p class="font-semibold leading-snug">{when}</p><p class="text-ink-2 text-[0.95rem]">{what}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>


  <!-- Guides -->
  <section class="container-x py-16 md:py-20">
    <div class="max-w-2xl mb-10">
      <p class="eyebrow mb-4">Guides</p>
      <h2>What to do, in the order you'll need it</h2>
      <p class="lede mt-4">Read the guides in order, or go straight to the part you're dealing with.</p>
    </div>
    <GuideList />
  </section>

  <!-- Why -->
  <section class="border-t border-line bg-paper-2">
    <div class="container-x py-16 md:py-20 grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <div>
        <p class="eyebrow mb-4">Why this exists</p>
        <h2>A will says who inherits. It doesn't say where anything is, or who has to be told.</h2>
      </div>
      <div class="prose text-ink-2">
        <p>Around 187,000 people die in Australia each year, and roughly two thirds of them are over 75. Many leave superannuation, property and sometimes a self-managed super fund. The Australian Taxation Office expects most estates to take six to twelve months to finalise, and many take longer.</p>
        <p>Most of that time goes on administration. Every bank, fund and agency asks for its own forms and certified copies. Superannuation follows different rules from the will. Some deadlines are strict and nobody announces them. And the executor is usually doing all of it for the first time, while grieving.</p>
        <p>Alan Estate was started by people who have administered an estate themselves. We wrote down the order of things, what each step needs, who to contact and where the expensive mistakes happen, and made it free to use.</p>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="border-t border-line">
    <div class="container-x py-16 md:py-20 grid gap-10 md:grid-cols-3">
      {[
        ['Sourced, and clear about limits', 'Every step links to the official source: the court, the ATO, Services Australia or your state registry. Where the rules differ by state, we say so. Where a matter needs a professional, we say that too.'],
        ['At your pace', "Most of this can wait until after the funeral. The plan shows the few things that can't, and holds the rest until you're ready."],
        ['Private by default', "The plan runs in your browser. There's no account, and we don't see your answers."],
      ].map(([h, p]) => (
        <div>
          <h3 class="text-[1.2rem]">{h}</h3>
          <p class="mt-2 text-ink-2">{p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- What we're building -->
  <section id="updates" class="border-t border-line bg-paper-2 scroll-mt-20">
    <div class="container-x py-16 md:py-20 grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="eyebrow mb-4">What we're building</p>
        <h2>One place for the whole estate, shared by the family and their advisers.</h2>
        <p class="mt-4 text-ink-2">We're building the Alan Estate platform: a single, current record of what a person owns and who to call, kept up to date while they're alive, and turned into a step-by-step plan for their executor when they die. Their accountant, lawyer or funeral director can see what they need, when the family allows it.</p>
        <p class="mt-6"><a href="/professionals/" class="btn btn-secondary">For professionals: become a founding partner</a></p>
      </div>
      <UpdatesForm heading="Keep me updated" intro="We'll email you when the platform opens to families. Occasional updates only, and you can unsubscribe at any time." source="home" />
    </div>
  </section>
</Base>
