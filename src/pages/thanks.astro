---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" noindex>
  <section class="container-x py-20 max-w-2xl">
    <p class="eyebrow mb-4">You're on the list</p>
    <h1>Thank you.</h1>
    <p class="lede mt-5">We'll write when there's something worth your time. Until then, the guide is free and yours to use.</p>
    <div class="mt-8 flex gap-3 flex-wrap">
      <a href="/guide/" class="btn btn-primary">Build your plan</a>
      <a href="/" class="btn btn-secondary">Back to the start</a>
    </div>
  </section>
</Base>
