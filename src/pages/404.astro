---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container-x py-20 max-w-2xl">
    <p class="eyebrow mb-4">404</p>
    <h1>That page isn't here.</h1>
    <p class="lede mt-5">It may have moved, or the link may be wrong. The guide is the place most people are looking for.</p>
    <div class="mt-8 flex gap-3 flex-wrap">
      <a href="/guide/" class="btn btn-primary">Build your plan</a>
      <a href="/" class="btn btn-secondary">Back to the start</a>
    </div>
  </section>
</Base>
